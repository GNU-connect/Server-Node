{
  "name": "server-node",
  "private": true,
  "packageManager": "pnpm@9.9.0",
  "scripts": {
    "prepare": "husky",
    "lint-staged": "lint-staged",
    "test": "pnpm run test:api && pnpm run test:mobile && pnpm run test:admin",
    "test:api": "pnpm --dir services/api/app exec jest --runInBand",
    "test:mobile": "pnpm --dir mobile exec jest --runInBand",
    "test:admin": "pnpm --dir admin test"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0"
  }
}
